---
import { navigation, site } from '../lib/content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="logo" aria-label={`${site.brandName} home`}>
      <svg
        class="logo__mark"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="0" y="1" width="20" height="4" rx="2" fill="currentColor"></rect>
        <rect x="0" y="8" width="13" height="4" rx="2" fill="currentColor" opacity="0.32"></rect>
        <rect x="0" y="15" width="8" height="4" rx="2" fill="currentColor" opacity="0.32"></rect>
      </svg>
      <span>{site.brandName}</span>
    </a>

    <nav class="nav" aria-label="Main">
      {
        navigation.header.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header__cta">
      <a href="/contact" class="btn btn--primary">Free visibility check</a>
    </div>

    <details class="nav-toggle">
      <summary aria-label="Open menu">Menu</summary>
      <div class="nav-drawer">
        <div class="wrap">
          <ul>
            {
              navigation.header.map((link) => (
                <li>
                  <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/contact">Contact</a></li>
          </ul>
          <a href="/contact" class="btn btn--primary" style="margin-top:1rem;width:100%">
            Free visibility check
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
